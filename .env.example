# Security
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-secure-key-in-production
ALLOWED_HOSTS=*

# Time Zone (Asia/Kolkata for IST)
TIME_ZONE=Asia/Kolkata

# Database Configuration:
# Leave DB_ENGINE empty or set to sqlite3 to use local SQLite development database.
# To connect to MySQL as specified in the PRD, set DB_ENGINE=mysql:
DB_ENGINE=sqlite3
DB_NAME=expense_tracker
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
USE_MYSQL=False

# Default Admin User (Used by python manage.py init_app)
ADMIN_USER=admin
ADMIN_PASS=admin123
